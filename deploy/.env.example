# Every setting PR Flagger reads from the environment. Copy to deploy/.env (it is
# gitignored) for Compose, or to /etc/prflagger/env for systemd, and fill in.
# Credentials belong here and nowhere else — never in config.toml or the repository.

# Sign-in. Generate each with:  openssl rand -hex 32
PRFLAGGER_ADMIN_TOKEN=
PRFLAGGER_VIEWER_TOKEN=

# GitHub: polling, review history, and cloning private repositories.
GITHUB_TOKEN=
# GitHub Enterprise Server only, e.g. https://ghe.example.com/api/v3
PRFLAGGER_GITHUB_API=

# The model on Amazon Bedrock. A Bedrock API key, or AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY. Verify with:  prflagger llm check
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Where major-update alerts are posted (Slack incoming webhook or any JSON endpoint).
PRFLAGGER_NOTIFY_WEBHOOK=

# Compose only: where data lives on the host (the same path is used inside the
# container), the host's docker group id (getent group docker | cut -d: -f3), and
# the loopback port to publish.
PRFLAGGER_DATA=/var/lib/prflagger
DOCKER_GID=
PRFLAGGER_PORT=8000
